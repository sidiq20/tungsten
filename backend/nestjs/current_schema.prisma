generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @db.VarChar(255)
  username        String         @unique(map: "ix_users_username") @db.VarChar(50)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  fullName        String?        @map("full_name") @db.VarChar(100)
  reputationScore Int?           @map("reputation_score")
  role            String?        @db.VarChar(20)
  isVerified      Boolean?       @map("is_verified")
  isBanned        Boolean?       @map("is_banned")
  createdAt       DateTime?      @map("created_at") @db.Timestamp(6)
  admins          admins?
  auditLogs       AuditLog[]
  subscriptions   Subscription[]
  posts           Post[]         @relation("AuthorPosts")
  reportsCreated  Report[]       @relation("ReportedBy")
  reportsResolved Report[]       @relation("ResolvedBy")
  bookmarks       Bookmark[]
  votes           Vote[]

  @@unique([email, role], map: "_email_role_uc")
  @@index([email], map: "ix_users_email")
  @@index([reputationScore], map: "ix_users_reputation_score")
  @@map("users")
}

model Course {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique(map: "ix_courses_code") @db.VarChar(20)
  name          String         @db.VarChar(255)
  description   String?
  department    String?        @db.VarChar(100)
  createdAt     DateTime?      @map("created_at") @db.Timestamp(6)
  subscriptions Subscription[]
  posts         Post[]

  @@map("courses")
}

model Post {
  id          String     @id @default(uuid()) @db.Uuid
  authorId    String     @map("author_id") @db.Uuid
  title       String     @db.VarChar(200)
  content     String
  status      String?    @db.VarChar(50)
  createdAt   DateTime?  @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?  @map("updated_at") @db.Timestamp(6)
  courseId    String?    @map("course_id") @db.Uuid
  fileUrl     String?    @map("file_url") @db.VarChar(255)
  fileType    String?    @map("file_type") @db.VarChar(50)
  viewCount   Int?       @map("view_count")
  upvotes     Int?
  isAnonymous Boolean?   @map("is_anonymous")
  tags        NoteTag[]
  author      User       @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course      Course?    @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  bookmarks   Bookmark[]

  @@map("posts")
}

model Tag {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique(map: "ix_tags_name") @db.VarChar(50)
  slug        String    @unique(map: "ix_tags_slug") @db.VarChar(50)
  description String?   @db.VarChar(255)
  posts       NoteTag[]

  @@map("tags")
}

model NoteTag {
  noteId String @map("note_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  post   Post   @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([noteId, tagId])
  @@map("note_tags")
}

model Bookmark {
  userId     String    @map("user_id") @db.Uuid
  postId     String    @map("post_id") @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, postId])
  @@map("user_bookmarks")
}

model Subscription {
  userId     String    @map("user_id") @db.Uuid
  courseId   String    @map("course_id") @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, courseId])
  @@map("course_subscriptions")
}

model Vote {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  targetType String    @map("target_type") @db.VarChar(50)
  targetId   String    @map("target_id") @db.Uuid
  value      Int
  createdAt  DateTime? @map("created_at") @db.Timestamp(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, targetType, targetId], map: "_user_target_vote_uc")
  @@map("votes")
}

model Report {
  id             String    @id @default(uuid()) @db.Uuid
  reporterId     String    @map("reporter_id") @db.Uuid
  targetType     String    @map("target_type") @db.VarChar(50)
  targetId       String    @map("target_id") @db.Uuid
  reason         String    @db.VarChar(255)
  status         String?   @db.VarChar(20)
  resolvedById   String?   @map("resolved_by_id") @db.Uuid
  resolutionNote String?   @map("resolution_note") @db.VarChar(255)
  createdAt      DateTime? @map("created_at") @db.Timestamp(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamp(6)
  reporter       User      @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resolvedBy     User?     @relation("ResolvedBy", fields: [resolvedById], references: [id], onUpdate: NoAction)

  @@map("reports")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  action       String    @db.VarChar(100)
  description  String?   @db.VarChar(255)
  metadataJson Json?     @map("metadata_json") @db.Json
  timestamp    DateTime? @db.Timestamp(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("audit_logs")
}

model admins {
  id                String    @id @db.Uuid
  user_id           String    @unique @db.Uuid
  permissions_level Int?
  is_active         Boolean?
  last_active       DateTime? @db.Timestamp(6)
  created_at        DateTime? @db.Timestamp(6)
  users             User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}


